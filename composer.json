{
    "name": "hradigital/php-exceptions",
    "description": "PHP Domain Exceptions library — a curated set of reusable, semantic exceptions for Domain-Driven Design applications.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/HRADigital/php-exceptions",
    "support": {
        "issues": "https://github.com/HRADigital/php-exceptions/issues",
        "source": "https://github.com/HRADigital/php-exceptions"
    },
    "authors": [
        {
            "name": "Hugo Rafael Azevedo",
            "email": "github@hradigital.com",
            "role": "Maintainer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": [
        "php",
        "exceptions",
        "domain-exceptions",
        "ddd",
        "domain-driven-design",
        "domain"
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "HraDigital\\Components\\Exceptions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HraDigital\\Tests\\Components\\Exceptions\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
